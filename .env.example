# Application Environment
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Multi-tenancy Configuration
MULTI_TENANT=false
DEFAULT_TENANT=default

# Database Configuration
# PostgreSQL (recommended for production)
DATABASE_URL=postgresql://user:password@localhost:5432/tribely
# SQLite (recommended for development)
# DATABASE_URL=file:./tribely.db

# Payload CMS Configuration
PAYLOAD_SECRET=your-payload-secret-here-change-this
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001

# Authentication
JWT_SECRET=your-jwt-secret-here-change-this
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here-change-this

# Email Configuration (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@tribely.xyz
FROM_NAME=Tribely

# File Storage Configuration
STORAGE_TYPE=local
# For cloud storage (S3/R2/etc)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=

# Payment Processing (optional)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Development/Debug
DEBUG=false
VERBOSE_LOGGING=false