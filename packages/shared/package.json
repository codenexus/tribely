{
  "name": "@tribely/shared",
  "version": "0.1.0",
  "description": "Shared types and utilities for Tribely platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "keywords": [
    "tribely",
    "types",
    "shared",
    "typescript"
  ],
  "author": "Jeremy Schaffer <jeremys@codenexus.org>",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.4.3",
    "@types/node": "^20.11.30"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}